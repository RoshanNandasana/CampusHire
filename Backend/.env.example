# CampusHire Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
# For local development with Docker
DATABASE_URL=postgresql+asyncpg://campushire:campushire@postgres:5432/campushire_db
# For local development without Docker
# DATABASE_URL=postgresql+asyncpg://campushire:campushire@localhost:5432/campushire_db
# For SQLite (development only)
# DATABASE_URL=sqlite+aiosqlite:///./campushire.db

# JWT Secret - Change this in production!
SECRET_KEY=19e87cf6f495f9c528bcdcd0b6af2949cf049d5401e78c670becb111771780ca8f300bbb15303f309df5bf1cb0e7e932d41902174c8b0d9c0fc6e59345fa3071

# CORS - Update these for production
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:5173"]

# Email Configuration (for future use)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# MinIO Configuration (for file storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_MATERIALS=study-materials

# Logger
LOG_LEVEL=INFO
