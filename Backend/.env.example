# CampusHire Backend Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
# For PostgreSQL with Docker
DATABASE_URL=postgresql+asyncpg://campushire:campushire@postgres:5432/campushire_db
# For PostgreSQL without Docker (local)
# DATABASE_URL=postgresql+asyncpg://campushire:campushire@localhost:5432/campushire_db

# Demo Data
# The backend auto-creates tables and seeds demo data on startup.
# Default super-admin login after first seed:
# admin@campushire.com / Admin@1234

# PASETO Token Configuration (v4 local/symmetric encryption)
# Generate a secure secret key for production (min 32 characters)
PASETO_SECRET_KEY=your-secure-paseto-secret-key-change-in-production

# CORS Configuration
# Update these with your actual frontend URLs for production
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:5173"]

# Email Configuration (FastAPI-mail)
# SMTP Server settings for sending notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@campushire.com
SMTP_FROM_NAME=CampusHire
SMTP_USE_TLS=true
ENABLE_EMAIL=true

# MinIO Configuration (for file storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_MATERIALS=study-materials

# OpenRouter Configuration (for AI-powered features like resume analysis)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_APP_NAME=CampusHire
