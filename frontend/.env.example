# CampusHire Frontend Environment Variables
# Copy this file to .env and fill in your values

# ─── Backend URL ──────────────────────────────────────────────────────────────
# Your Render backend URL (no trailing slash, no /api suffix)
# Example: https://campushire-api.onrender.com
REACT_APP_API_BASE_URL=https://your-render-backend.onrender.com/api/v1

# ─── Local Development ────────────────────────────────────────────────────────
# For local dev, leave REACT_APP_API_BASE_URL unset (or set to /api/v1)
# and the setupProxy.js will proxy /api → http://localhost:8000 automatically.
# REACT_APP_API_BASE_URL=/api/v1
