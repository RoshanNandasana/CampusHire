# CampusHire Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Render: use your Neon / Supabase / Render PostgreSQL connection string.
# Local Docker: use the value below as-is.
DATABASE_URL=postgresql+asyncpg://campushire:campushire@localhost:5432/campushire_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret (min 32 chars).
# python -c "import secrets; print(secrets.token_hex(32))"
PASETO_SECRET_KEY=your-secure-paseto-secret-key-change-in-production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins.
# On Render, set this to your Vercel URL:
#   ["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Email (optional) ─────────────────────────────────────────────────────────
# Leave ENABLE_EMAIL=false to skip email sending entirely.
ENABLE_EMAIL=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@campushire.com
SMTP_FROM_NAME=CampusHire
SMTP_USE_TLS=true

# ─── MinIO / File Storage (optional) ──────────────────────────────────────────
# Leave MINIO_ENDPOINT blank on Render to disable file uploads (safe default).
# For local Docker, use the values below.
# For production, point to a self-hosted MinIO or an S3-compatible service.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_MATERIALS=study-materials

# ─── OpenRouter (optional — AI resume analysis) ───────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-frontend.vercel.app
OPENROUTER_APP_NAME=CampusHire
